{
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/work/:slug/",
      "destination": "/work/project.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/work/project.html"
    }
  ],
  "headers": [
    {
      "source": "/content.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}